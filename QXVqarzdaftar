<!DOCTYPE html>
<html lang="uz" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QXVbrand QARZ DAFTARCHASI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @keyframes pulseGlow {
      0%, 100% { opacity: 0.8; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.03); }
    }
    .gold-gradient-bg {
      background: radial-gradient(circle at center, #1f1908 0%, #080808 70%, #000000 100%);
      animation: pulseGlow 6s infinite ease-in-out;
    }
    .gold-text {
      background: linear-gradient(135deg, #FFF5C0 0%, #E6C667 30%, #D4AF37 50%, #F3E5AB 80%, #AA7C11 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .gold-border { border-color: rgba(212, 175, 55, 0.4); }
  </style>
</head>
<body class="bg-black text-gray-100 font-sans min-h-screen select-none antialiased overflow-x-hidden">

  <!-- 1. SPLASH SCREEN (5 SONIYA) -->
  <div id="splash" class="fixed inset-0 z-50 flex flex-col items-center justify-between p-8 gold-gradient-bg transition-opacity duration-700">
    <div class="pt-8"></div>
    <div class="flex flex-col items-center text-center space-y-3">
      <!-- QXV -->
      <h1 class="text-7xl font-extrabold tracking-widest gold-text drop-shadow-[0_5px_15px_rgba(212,175,55,0.4)]">
        QXV
      </h1>
      <!-- BRAND -->
      <h2 class="text-3xl font-bold tracking-[0.3em] gold-text">
        BRAND
      </h2>
      <!-- QARZ DAFTARCHASI -->
      <div class="mt-4 px-6 py-2 rounded-full border gold-border bg-black/60 backdrop-blur-md">
        <span class="text-white text-sm md:text-base font-semibold tracking-wider">
          QARZ DAFTARCHASI
        </span>
      </div>
    </div>

    <!-- PASDAGI XUSH KELIBSIZ VA TIMER -->
    <div class="w-full max-w-xs flex flex-col items-center space-y-4 pb-8">
      <div class="text-gold-text text-xl font-bold tracking-widest gold-text uppercase animate-pulse">
        XUSH KELIBSIZ
      </div>
      <div class="w-16 h-16 rounded-full border-2 border-amber-500/30 flex items-center justify-center bg-black/40">
        <span id="countdown" class="text-2xl font-black gold-text">5</span>
      </div>
    </div>
  </div>

  <!-- 2. ASOSIY ILOVA SHABLONI -->
  <div id="app" class="hidden min-h-screen flex flex-col gold-gradient-bg">
    <!-- HEADER -->
    <header class="sticky top-0 z-40 bg-black/80 backdrop-blur-md border-b gold-border px-4 py-3 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <!-- UZB BAYROGI -->
        <span class="text-xl">🇺🇿</span>
        <span class="font-bold gold-text text-lg">QXVbrand</span>
      </div>
      <button onclick="openCallCenter()" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-xs font-semibold px-3 py-1.5 rounded-full flex items-center space-x-1.5 transition">
        <i class="fa-solid font-bold fa-headset"></i>
        <span>CALL CENTER</span>
      </button>
    </header>

    <!-- CONTENT -->
    <main class="flex-1 max-w-2xl w-full mx-auto p-4 space-y-4">
      <div class="p-6 rounded-2xl bg-black/60 border gold-border text-center space-y-2">
        <p class="text-gray-400 text-sm">Jami Qarzdorlik</p>
        <p class="text-3xl font-extrabold gold-text">1,500,000 UZS</p>
      </div>

      <div class="bg-black/40 border gold-border rounded-xl p-4 text-center">
        <p class="text-gray-300 text-sm">Xush kelibsiz! Tizim muvaffaqiyatli ishga tushdi.</p>
      </div>
    </main>
  </div>

  <!-- CALL CENTER MODAL -->
  <div id="callCenterModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-neutral-900 border gold-border rounded-2xl p-6 max-w-sm w-full space-y-4 text-center">
      <h3 class="text-lg font-bold gold-text">CALL CENTER</h3>
      <p class="text-sm text-gray-300">
        Noqulaylikka yoki shikoyat yokida biror bir taklifingiz bo'lsa Telegram <strong class="gold-text">@QXVbrand</strong> ga murojaat qiling.
      </p>
      <a href="https://t.me/QXVbrand" target="_blank" class="block w-full py-2.5 bg-amber-500 hover:bg-amber-600 text-black font-bold rounded-xl text-sm transition">
        Telegram-ga o'tish
      </a>
      <button onclick="closeCallCenter()" class="text-xs text-gray-400 underline pt-2">Yopish</button>
    </div>
  </div>

  <script>
    // 5 Soniyalik teskari sanoq va Splash Screenni yopish
    let count = 5;
    const countdownEl = document.getElementById('countdown');
    const splashEl = document.getElementById('splash');
    const appEl = document.getElementById('app');

    const timer = setInterval(() => {
      count--;
      if (count > 0) {
        countdownEl.textContent = count;
      } else {
        clearInterval(timer);
        splashEl.classList.add('opacity-0');
        setTimeout(() => {
          splashEl.classList.add('hidden');
          appEl.classList.remove('hidden');
        }, 700);
      }
    }, 1000);

    function openCallCenter() {
      document.getElementById('callCenterModal').classList.remove('hidden');
    }
    function closeCallCenter() {
      document.getElementById('callCenterModal').classList.add('hidden');
    }
  </script>
</body>
</html>
